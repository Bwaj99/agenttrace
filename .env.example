# Copy this file to .env and fill in the values you need.
# Only ONE of OPENAI_API_KEY / ANTHROPIC_API_KEY is required — the
# demo agent and the backend's replay endpoint pick whichever is set.

# OpenAI API key (used by the demo agent + replay endpoint if set)
OPENAI_API_KEY=

# Anthropic API key (used by the demo agent + replay endpoint if set)
ANTHROPIC_API_KEY=

# Path to the shared SQLite file. Defaults match the Docker Compose
# volume mount; override for local (non-Docker) development.
AGENTTRACE_DB_PATH=./agenttrace.db

# Frontend -> backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
